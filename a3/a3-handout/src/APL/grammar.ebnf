Atom ::= var | int | bool | “(” Exp “)”
LExp ::= Atom 
     | “if” Exp “then” Exp “else” Exp
     | “\” var “->” Exp
     | “try” Exp “catch” Exp
     | “let” var “=” Exp “in” Exp
     | “loop” var “=” Exp “for” var “<” Exp “do” Exp
Exp ::= LExp
     | Exp “+” Exp
     | Exp “-” Exp
     | Exp “*” Exp
     | Exp “/” Exp
     | Exp “**” Exp
     | Exp “==” Exp
	 | "get" Atom
	 | "put" Atom Atom
	 | "print" string atom
