Atom ::= var | int | bool | "(" Exp ")" ;
FExp ::= Atom | FExp Atom ;
LExp ::= FExp
       | "if" Exp "then" Exp "else" Exp
       | "\" var "->" Exp
       | "try" Exp "catch" Exp
       | "let" var "=" Exp "in" Exp
       | "loop" var "=" Exp "for" var "<" Exp "do" Exp ;
Exp4 ::= LExp | "get" Atom | "put" Atom Atom | "print" string Atom ;
Exp3 ::= Exp4 | Exp4 "**" Exp4 ;
Exp2 ::= Exp3 | Exp2 "*" Exp3 | Exp2 "/" Exp3 ;
Exp1 ::= Exp2 | Exp1 "+" Exp2 | Exp1 "-" Exp2 ;
Exp  ::= Exp1 | Exp "==" Exp1 ;
